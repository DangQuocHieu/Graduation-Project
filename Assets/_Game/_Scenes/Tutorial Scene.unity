  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 09c539e6f18863842b4511de78027f9e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  playerController: {fileID: 592611672}
  tutorialScreen: {fileID: 318110068}
  tutorialDialogueBox: {fileID: 324875699}
  tutorialStrings:
  - Hold SHIFT to crouch
  - Find bamboo tray
  - Press LEFT CLICK to pick up the bamboo tray
  - Move to the fridge
  - Press LEFT CLICK to open left door
  - Open right door
  - Press LEFT CLICK to add rice noodles to your tray
  - Press LEFT CLICK to add herbs to your tray
  - Go to the green arrow
  - Press LEFT CLICK to put the tray down
  - Find and pickup frying pan
  - Go to the stove
  - Press LEFT CLICK to place pan on the stove
  - Pick up the cooking oil bottle
  - Press LEFT CLICK to pour oil into the pan
  - Put the cooking oil bottle down
  - Pickup tofu from fridge
  - Drop tofu into the pan
  - Turn on the stove
  - Aim at the tofu
  - Wait until the tofu is cooked
  - Take the tofu out of the frying pan
  - Place the tofu on the cutting board
  - Pickup cucumber from fridge
  - Place the cucumber on the cutting board
  - Pickup knife
  - Aim at the tofu
  - Press LEFT CLICK to cut
  - Aim at the cucumber
  - Press LEFT CLICK to cut
  - Drop the knife
  - Pickup the bamboo tray
  currentStringIndex: 0
  hoverController: {fileID: 592611673}
  pickupAndDropHandler: {fileID: 592611674}
